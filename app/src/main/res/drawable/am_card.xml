<?xml version="1.0" encoding="utf-8"?>
<!-- Host card: elevated surface, desktop card radius. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/am_ripple">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/am_surface" />
            <stroke android:width="1dp" android:color="@color/am_border" />
        </shape>
    </item>
</ripple>

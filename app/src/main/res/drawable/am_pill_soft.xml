<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary pill: soft-accent fill with a border, desktop's accentSoft card treatment. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/am_ripple">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/am_accent_soft" />
            <stroke android:width="1dp" android:color="@color/am_border_strong" />
        </shape>
    </item>
</ripple>

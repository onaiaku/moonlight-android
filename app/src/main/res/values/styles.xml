<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        ArtMoon application theme. The StreamTheme deliberately keeps the transparent
        window background from upstream: extra overdraw behind the video surface is
        wasted frames, and the desktop agrees — the stream view is all video.
    -->
    <style name="AppTheme" parent="AppBaseTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="StreamBaseTheme" parent="AppBaseTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="StreamTheme" parent="StreamBaseTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>

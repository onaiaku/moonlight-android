<?xml version="1.0" encoding="utf-8"?>
<!--
    ArtMoon host screen, LANDSCAPE (TV / phone rotated — the Shield's native
    orientation). Ported from the desktop's wide layout: wordmark + subtitle +
    vertical pill rail on the left, host list filling the rest.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/am_ground"
    tools:context=".PcView" >

    <!-- Left rail: branding + actions, like the desktop's left column. -->
    <LinearLayout
        android:id="@+id/am_rail"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingLeft="18dp"
        android:paddingEnd="10dp"
        android:paddingRight="10dp"
        android:paddingTop="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/am_wordmark"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:textColor="@color/***" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/***"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="@color/***" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/am_pill_soft"
            android:scaleType="fitCenter"
            android:padding="11dp"
            android:src="@drawable/ic_settings"
            android:nextFocusForward="@id/helpButton"
            android:preferKeepClear="true"
            android:contentDescription="@string/am_settings" />

        <ImageButton
            android:id="@+id/helpButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/am_pill_soft"
            android:scaleType="fitCenter"
            android:padding="11dp"
            android:src="@drawable/ic_help"
            android:nextFocusForward="@id/manuallyAddPc"
            android:preferKeepClear="true"
            android:contentDescription="@string/help" />

        <ImageButton
            android:id="@+id/manuallyAddPc"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/***"
            android:scaleType="fitCenter"
            android:padding="11dp"
            android:src="@drawable/ic_add"
            android:tint="@color/am_on_accent"
            android:nextFocusForward="@id/pcFragmentContainer"
            android:preferKeepClear="true"
            android:contentDescription="@string/am_add_pc" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layout_toEndOf="@+id/am_rail"
        android:layout_toRightOf="@+id/am_rail" >

        <RelativeLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true">
            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/am_accent"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/pcs_loading"
                android:layout_toEndOf="@+id/pcs_loading"
                android:layout_marginLeft="12dp"
                android:layout_marginStart="12dp"
                android:layout_centerVertical="true"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="@color/***"
                android:text="@string/searching_pc"/>
        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>

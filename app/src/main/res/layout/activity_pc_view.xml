<?xml version="1.0" encoding="utf-8"?>
<!--
    ArtMoon host screen. Desktop port: theArtMoon wordmark header on the ground
    colour, toolbar actions as soft-accent circular buttons, grid on the dark ground.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/am_ground"
    tools:context=".PcView" >

    <TextView
        android:id="@+id/am_wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="14dp"
        android:text="@string/app_name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:textColor="@color/am_text_primary" />

    <TextView
        android:id="@+id/am_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/am_wordmark"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="2dp"
        android:text="@string/am_hosts_subtitle"
        android:textSize="12sp"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="@color/am_text_secondary" />

    <LinearLayout
        android:id="@+id/am_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/am_pill_soft"
            android:scaleType="fitCenter"
            android:padding="11dp"
            android:src="@drawable/ic_settings"
            android:preferKeepClear="true"
            android:contentDescription="@string/am_settings" />

        <ImageButton
            android:id="@+id/helpButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/am_pill_soft"
            android:scaleType="fitCenter"
            android:padding="11dp"
            android:src="@drawable/ic_help"
            android:preferKeepClear="true"
            android:contentDescription="@string/help" />

        <ImageButton
            android:id="@+id/manuallyAddPc"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/am_pill_accent"
            android:scaleType="fitCenter"
            android:padding="11dp"
            android:src="@drawable/ic_add"
            android:tint="@color/am_on_accent"
            android:preferKeepClear="true"
            android:contentDescription="@string/am_add_pc" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_below="@+id/am_subtitle"
        android:layout_alignParentBottom="true" >

        <RelativeLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:layout_centerInParent="true">
            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/am_accent" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/pcs_loading"
                android:layout_toEndOf="@+id/pcs_loading"
                android:layout_marginLeft="12dp"
                android:layout_marginStart="12dp"
                android:layout_centerVertical="true"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="@color/am_text_secondary"
                android:text="@string/searching_pc"/>
        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>

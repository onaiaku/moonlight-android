<?xml version="1.0" encoding="utf-8"?>
<!--
    ArtMoon host HERO CARD — ported 1:1 from the approved render
    (/home/rias/artmoon-android-preview.html, DESIGN APPROVED 2026-09-05).
    Full-bleed gradient card; badge row top-left; live ArtLight telemetry
    top-right; big shadowed hostname + ready line + spec chips bottom-left.
    Per-host photo, HOST LINK number and LAST SESSION block appear when the
    data feeds exist (spec §2: hidden until real, never faked).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/am_hero_height"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/am_hero_bg">

        <!-- bottom scrim for text legibility -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/am_hero_scrim" />

        <!-- badge row, top-left -->
        <LinearLayout
            android:id="@+id/am_badge_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="12dp"
            android:layout_marginStart="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/am_hero_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/am_dot_pairing"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/status_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"
                    android:textColor="@color/am_text_primary"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/am_auth_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/am_hero_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/am_dot_auth"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/am_hero_auth"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"
                    android:textColor="@color/am_text_primary"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- live ArtLight telemetry, top-right -->
        <TextView
            android:id="@+id/am_telemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="14dp"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:textColor="@color/am_text_secondary"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:visibility="gone" />

        <!-- identity block, bottom-left -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/grid_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="@color/am_text_primary"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="12"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/am_ready_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/am_text_secondary"
                android:shadowColor="#E6000000"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:maxLines="1" />

            <LinearLayout
                android:id="@+id/am_spec_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/am_spec_res"
                    style="@style/AmSpecChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/am_spec_fps"
                    style="@style/AmSpecChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/am_spec_bitrate"
                    style="@style/AmSpecChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- glyph well + spinner + overlay, kept from the old card so the
             adapter's existing binding keeps working -->
        <FrameLayout
            android:id="@+id/am_glyph_well"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12dp"
            android:alpha="0.55">

            <ImageView
                android:id="@+id/grid_image"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/grid_overlay"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />

            <ProgressBar
                android:id="@+id/grid_spinner"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
